{
    "name": "spinncreative.co.uk",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "type-check": "tsc --noEmit",
        "dev": "concurrently \"npm run test:watch\" \"next dev\"",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "lint-staged": "lint-staged",
        "prepare": "husky",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:watch-all": "nodemon --exec 'npm run test' --watch src --watch tests --ext js,jsx, ts,tsx"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run lint-staged"
        }
    },
    "lint-staged": {
        "*.js": "eslint --fix",
        "*.jsx": "eslint --fix",
        "*.ts": "eslint --fix",
        "*.tsx": "eslint --fix"
    },
    "dependencies": {
        "@tailwindcss/container-queries": "^0.1.1",
        "@types/nodemailer": "^6.4.16",
        "embla-carousel-autoplay": "^8.3.0",
        "embla-carousel-react": "^8.3.0",
        "next": "14.2.12",
        "nodemailer": "^6.9.15",
        "react": "^18",
        "react-dom": "^18",
        "react-feather": "^2.0.10",
        "sharp": "^0.33.5"
    },
    "devDependencies": {
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/typography": "^0.5.15",
        "@types/jest": "^29.5.13",
        "@types/node": "^22.5.5",
        "@types/react": "^18.3.7",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^8.6.0",
        "@typescript-eslint/parser": "^8.6.0",
        "concurrently": "^9.0.1",
        "eslint": "^8.0.0",
        "eslint-config-next": "14.2.12",
        "eslint-config-prettier": "^9.1.0",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.10",
        "nodemon": "^3.1.5",
        "postcss": "^8.4.47",
        "prettier": "3.3.3",
        "sass": "^1.79.1",
        "tailwindcss": "^3.4.12",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.2"
    }
}
